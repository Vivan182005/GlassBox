# Copy to .env for local runs; on Render, set the same keys under Environment.

# LLM (resume reading, tailoring, form answers). Groq is primary, Gemini the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Job sites. Without these, search covers only the curated company career pages.
# JSearch on RapidAPI: LinkedIn, Naukri, Indeed and Glassdoor listings (free tier: 200 requests/month).
RAPIDAPI_KEY=
# Adzuna developer API: Indian job boards (free tier).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional
SUPABASE_URL=
SUPABASE_ANON_KEY=
