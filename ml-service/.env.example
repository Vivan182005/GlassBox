# Copy to .env for local runs; on Render, set the same keys under Environment.

# LLM (resume reading, tailoring, form answers). Groq is primary, Gemini the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Job sites. Without these, search covers only the curated company career pages.
# JSearch on RapidAPI: LinkedIn, Naukri, Indeed, Internshala and Glassdoor listings (free tier: 200 requests/month).
RAPIDAPI_KEY=

# Extra browser origins allowed to call the API (comma-separated); GlassBox's
# own Vercel sites and localhost:3000 are always allowed.
ALLOWED_ORIGINS=
